# Required: OpenSea developer API key
OPENSEA_API_KEY=

# Public wallet addresses only. Never put private keys or seed phrases here.
WALLETS=0xYourWallet1,0xYourWallet2

# Comma-separated OpenSea collection slugs to watch.
WATCH_SLUGS=black-ink-robin,pixelated-puffins,suited-ape-society,chilliens

# Safety controls
POLL_MS=3000
MAX_MINT_VALUE_WEI=500000000000000
MAX_QUANTITY=1
PORT=4317

# Robinhood Chain mainnet
RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
